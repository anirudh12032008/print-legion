# Airtable Configuration
AIRTABLE_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_base_id_here
AIRTABLE_TABLE_ID=Printers
AIRTABLE_REQUESTS_TABLE_ID=Requests

# Slack OAuth Configuration
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_CLIENT_ID=your_slack_client_id
SLACK_OAUTH_REDIRECT_URI=https://your-ngrok-url.ngrok-free.dev/auth/slack/callback

# JWT Secret (generate a random string)
JWT_SECRET=your_random_jwt_secret_here

# Backend URL (where the Express server runs)
BACKEND_URL=http://localhost:3000

# Frontend URL (where the Vite dev server runs)
FRONTEND_URL=http://localhost:5173

# Admin UI redirect after OAuth (usually same as FRONTEND_URL)
ADMIN_UI_REDIRECT=http://localhost:5173
